  "entrypoints": {
    "main": [
      "dev.voidechoes.VoidEchoes"
    ],
    "client": [
      "dev.voidechoes.client.VoidEchoesClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "betterend": "*"
  },
  "mixins": [
    "voidechoes.mixins.json"
  ]
